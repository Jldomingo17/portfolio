---
import Icon from "./Icon.astro";
import { education, languages, achievements } from "../data/cv";
---

<section class="section alt" id="formacion">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">05 · Formación</p>
      <h2 class="section-title">Formación, idiomas y <span class="grad">logros</span></h2>
    </div>

    <div class="layout">
      <ol class="studies" data-stagger>
        {
          education.map((e) => (
            <li class="study" data-reveal="left">
              <span class="cap">
                <Icon name="graduation-cap" size={20} />
              </span>
              <div>
                <p class="dates">
                  {e.dates}
                  {e.current && <span class="badge">En curso</span>}
                </p>
                <h3 class="study-title">{e.title}</h3>
                <p class="center">{e.center}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="side" data-stagger>
        <div class="panel" data-reveal>
          <h3 class="panel-title">
            <Icon name="globe" size={18} />
            Idiomas
          </h3>
          <ul class="langs">
            {
              languages.map((l) => (
                <li>
                  <span class="lang">{l.name}</span>
                  <span class="level">{l.level}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel" data-reveal>
          <h3 class="panel-title">
            <Icon name="trophy" size={18} />
            Logros
          </h3>
          <ul class="awards">
            {
              achievements.map((a) => (
                <li>
                  <span class="award">{a.title}</span>
                  <span class="place">{a.place}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .alt {
    background:
      radial-gradient(ellipse 55% 45% at 85% 0%, rgb(52 211 153 / 0.06), transparent 70%),
      var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* ---------- Estudios ---------- */
  .studies {
    display: grid;
    gap: 0.85rem;
  }

  .study {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
  }

  .cap {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(56 189 248 / 0.3);
    border-radius: 0.8rem;
    background: rgb(56 189 248 / 0.1);
    color: var(--accent);
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.65rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: 0.76rem;
  }

  .badge {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: rgb(52 211 153 / 0.12);
    color: var(--accent-2);
  }

  .study-title {
    margin-top: 0.4rem;
    font-family: var(--ff-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .center {
    margin-top: 0.3rem;
    color: var(--text-2);
    font-size: 0.93rem;
  }

  /* ---------- Idiomas y logros ---------- */
  .side {
    display: grid;
    gap: 0.85rem;
  }

  .panel {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.025);
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .panel-title :global(svg) {
    color: var(--accent);
  }

  .langs,
  .awards {
    display: grid;
    margin-top: 0.75rem;
  }

  .langs li,
  .awards li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    padding-block: 0.8rem;
  }

  .langs li + li,
  .awards li + li {
    border-top: 1px solid var(--line);
  }

  .lang,
  .award {
    font-weight: 600;
  }

  .level,
  .place {
    color: var(--text-2);
    font-size: 0.9rem;
  }

  @media (max-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
