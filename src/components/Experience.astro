---
import Icon from "./Icon.astro";
import { experience, otherExperience } from "../data/cv";
---

<section class="section" id="experiencia">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">02 · Experiencia</p>
      <h2 class="section-title">Informática y <span class="grad">sistemas</span></h2>
      <p class="section-sub">Del soporte y la monitorización de red a administrar infraestructura y dirigir Codivo.</p>
    </div>

    <!-- La línea se va rellenando con el scroll (--progress desde timeline.ts) -->
    <ol class="timeline" data-timeline>
      {
        experience.map((job) => (
          <li class="item" data-reveal>
            <span class="marker" aria-hidden="true" />

            <div class="meta">
              {job.dates.map((d) => <p class="date">{d}</p>)}
              {job.location && <p class="place">{job.location}</p>}
              {job.current && (
                <p class="now">
                  <span aria-hidden="true" />
                  Puesto actual
                </p>
              )}
              {job.dates.length === 0 && job.link && (
                <a class="site" href={job.link.href} target="_blank" rel="noopener noreferrer">
                  {job.link.label}
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )}
            </div>

            <article class="card">
              <h3 class="role">{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul class="bullets">
                {job.bullets.map((b) => (
                  <li>
                    {b.label && <strong>{b.label}: </strong>}
                    {b.text}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>

    <div class="other">
      <h3 class="other-title" data-reveal>Otra experiencia profesional</h3>
      <ul class="other-grid" data-stagger>
        {
          otherExperience.map((job) => (
            <li class="other-item" data-reveal>
              <p class="other-date">
                {job.dates} · {job.location}
              </p>
              <p class="other-role">{job.role}</p>
              <p class="other-company">{job.company}</p>
              <p class="other-desc">{job.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- Línea de tiempo ---------- */
  .timeline {
    --axis: 13.5rem;
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .timeline::before,
  .timeline::after {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--axis);
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
  }

  .timeline::before {
    background: var(--line);
  }

  .timeline::after {
    background: linear-gradient(180deg, #60a5fa, #22d3ee, #34d399);
    transform-origin: 50% 0;
    box-shadow: 0 0 14px rgb(34 211 238 / 0.6);
  }

  /* Sin JavaScript la línea se queda completa */
  :global(.js) .timeline::after {
    scale: 1 var(--progress, 0);
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: var(--axis) minmax(0, 1fr);
    align-items: start;
  }

  .marker {
    position: absolute;
    top: 1.55rem;
    left: var(--axis);
    z-index: var(--z-base);
    width: 0.85rem;
    height: 0.85rem;
    margin-left: -0.425rem;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    transition:
      border-color 0.5s 0.3s,
      box-shadow 0.5s 0.3s,
      background-color 0.5s 0.3s;
  }

  .item.is-visible .marker {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px rgb(56 189 248 / 0.16);
  }

  .meta {
    padding: 1.3rem 2rem 0 0;
    text-align: right;
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .date {
    color: var(--text);
  }

  .place {
    color: var(--muted);
  }

  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgb(52 211 153 / 0.12);
    color: var(--accent-2);
  }

  .now span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .site {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 1.75rem;
    color: var(--accent);
    text-decoration: none;
  }

  .site:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card {
    margin-left: 2rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
    transition: border-color 0.3s;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .role {
    font-family: var(--ff-display);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .company {
    margin-top: 0.3rem;
    color: var(--accent);
    font-weight: 500;
  }

  .bullets {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.1rem;
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .bullets li {
    position: relative;
    padding-left: 1.15rem;
  }

  .bullets li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    rotate: 45deg;
    border-radius: 1px;
    background: var(--accent);
    opacity: 0.75;
  }

  .bullets strong {
    color: var(--text);
    font-weight: 600;
  }

  /* ---------- Otra experiencia ---------- */
  .other {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .other-title {
    font-family: var(--ff-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .other-item {
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--line);
    border-left: 2px solid rgb(56 189 248 / 0.55);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.02);
  }

  .other-date {
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: 0.72rem;
  }

  .other-role {
    margin-top: 0.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .other-company {
    margin-top: 0.15rem;
    color: var(--text-2);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .other-desc {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (max-width: 64rem) {
    .other-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .timeline {
      --axis: 0.45rem;
      gap: 2rem;
    }

    .item {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 1.75rem;
    }

    .marker {
      top: 0.3rem;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.15rem 0.85rem;
      padding: 0 0 0.75rem;
      text-align: left;
    }

    .now {
      margin-top: 0;
    }

    .card {
      margin-left: 0;
    }
  }

  @media (max-width: 34rem) {
    .other-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
