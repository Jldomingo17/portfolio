---
import { terminal } from "../data/cv";

const prompt = "sergio@portfolio:~$";
---

<div class="tilt" data-tilt>
  <div class="frame">
    <div class="term">
      <div class="bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="title">sergio@portfolio: ~</span>
        <span class="shell">bash</span>
      </div>

      <!-- El texto se renderiza completo en el HTML: terminal.ts solo lo va
           destapando, así no hay saltos de layout ni dependencia de JS -->
      <div class="body" data-term role="img" aria-label="Terminal con un resumen del perfil de Sergio: administrador DevOps en Pinto, Madrid; stack con Ubuntu, Debian, Windows Server, Docker, Coolify, Active Directory, DNS y MySQL; DevOps en Reyes Legal Perito desde febrero de 2026; cursando ASIR.">
        {
          terminal.map((block) => (
            <>
              <p class="t-line" data-kind="cmd">
                <span class="t-prompt">{prompt}</span> <span class="t-text">{block.cmd}</span>
              </p>
              {block.out.map((line) => (
                <p class="t-line t-out" data-kind="out">
                  {line.map((seg) => (
                    <span class:list={[seg.tone && `t-${seg.tone}`]}>{seg.text}</span>
                  ))}
                </p>
              ))}
            </>
          ))
        }
        <p class="t-line t-idle" data-kind="idle">
          <span class="t-prompt">{prompt}</span> <span class="t-cursor"></span>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Inclinación 3D que sigue al puntero (--rx / --ry desde pointer-fx.ts) */
  .tilt {
    perspective: 70rem;
    animation: term-in 1.1s var(--ease-out) 0.35s both;
  }

  @keyframes term-in {
    from {
      opacity: 0;
      translate: 0 2.5rem;
      scale: 0.96;
    }
  }

  /* Borde luminoso: un degradado cónico grande que gira por transform
     (solo compositor) y que el panel opaco tapa salvo 1px de borde */
  .frame {
    position: relative;
    padding: 1px;
    border-radius: 1.05rem;
    overflow: hidden;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s var(--ease-out);
    box-shadow:
      0 30px 80px -20px rgb(0 0 0 / 0.8),
      0 0 70px -18px rgb(34 211 238 / 0.35);
  }

  .frame::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 160%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(
      from 0deg,
      rgb(148 163 184 / 0.18) 0deg,
      rgb(148 163 184 / 0.18) 200deg,
      #22d3ee 285deg,
      #34d399 330deg,
      rgb(148 163 184 / 0.18) 360deg
    );
    animation: spin 7s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  .term {
    position: relative;
    border-radius: 1rem;
    background: #090d15;
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .dots {
    display: inline-flex;
    gap: 0.4rem;
  }

  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .title {
    flex: 1;
    text-align: center;
  }

  .shell {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }

  .body {
    padding: 1.1rem 1.15rem 1.3rem;
    font-family: var(--ff-mono);
    font-size: clamp(0.72rem, 0.62rem + 0.42vw, 0.84rem);
    line-height: 1.75;
    color: var(--text);
  }

  .t-line {
    overflow-wrap: anywhere;
  }

  /* Los espacios dobles de las salidas son significativos */
  .t-line span {
    white-space: pre-wrap;
  }

  .t-out + .t-line[data-kind="cmd"],
  .t-out + .t-idle {
    margin-top: 0.55rem;
  }

  .t-prompt {
    color: var(--accent-2);
  }

  .t-out {
    color: var(--text-2);
  }

  .t-ok {
    color: var(--accent-2);
  }

  .t-accent {
    color: var(--accent);
  }

  .t-dim {
    color: var(--muted);
  }

  /* Cursor de bloque: en la línea que se está escribiendo y en el prompt final */
  .t-cursor,
  .t-line.is-typing :global(.t-typed)::after {
    content: "";
    display: inline-block;
    width: 0.58em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  .t-cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  :global(.t-rest) {
    visibility: hidden;
  }

  /* Antes de que arranque el script las líneas esperan ocultas (sin parpadeo
     de contenido). Si el script no llegara a cargar, aparecen solas a los 5 s */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .body:not(.is-live, .is-done) .t-line {
      visibility: hidden;
      animation: t-failsafe 0s linear 5s forwards;
    }
  }

  @keyframes t-failsafe {
    to {
      visibility: visible;
    }
  }

  .body.is-live .t-line:not(.is-on) {
    visibility: hidden;
  }
</style>
